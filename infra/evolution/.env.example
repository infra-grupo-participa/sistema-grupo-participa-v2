# Copie para .env na VPS (chmod 600). NUNCA commitar o .env. Gere segredos com: openssl rand -hex 32
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://wa.grupoparticipa.app.br

# Chave global da API. É a mesma que vai em EVOLUTION_API_KEY (Hostinger do app) e evolution_api_key (Vault do Supabase).
AUTHENTICATION_API_KEY=troque-por-openssl-rand-hex-32
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

POSTGRES_PASSWORD=troque-por-openssl-rand-hex-24
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:troque-pela-mesma-senha@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_crm
DATABASE_SAVE_DATA_INSTANCE=true
# o histórico mora no CRM (Supabase); a VPS não guarda mensagem
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

CONFIG_SESSION_PHONE_CLIENT=CRM Grupo Participa
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
DEL_INSTANCE=false

# o webhook é configurado pelo CRM, um por instância (com chave própria); o global fica desligado
WEBHOOK_GLOBAL_ENABLED=false

LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
CORS_ORIGIN=https://grupoparticipa.app.br
