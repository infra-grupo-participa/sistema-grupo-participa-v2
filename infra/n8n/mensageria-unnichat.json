   "id": "u4",
   "name": "Montar lote",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    720,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "// Decisões do João (06/10/2026): desde 01/10; tipo padrão 'marketing' (operador corrige na tela).\n// A API do Unnichat não devolve entregues/lidos: só contatos. Retorno fica 'não lançado' (pendência visível).\n// Disparo com 'teste' no nome não entra (envio de teste para 1-2 números da equipe).\nconst INICIO = '2026-10-01';\nconst contas = [['Disparos Seminário/HM/CNHF', 'Unnichat — Seminário/HM/CNHF'], ['Disparos HT (Marcio CSM)', 'Unnichat — HT (Marcio CSM)']];\nconst lote = [], visto = new Set();\nfor (const [no, conta] of contas) {\n  let itens = [];\n  try { itens = $(no).all(); } catch (e) { itens = []; }\n  for (const it of itens) {\n    for (const b of (it.json.data || [])) {\n      if (!b || !b.id || visto.has(b.id)) continue; visto.add(b.id);\n      const quando = b.sendAt || b.startedAt; if (!quando || quando < INICIO) continue;\n      if (/teste/i.test(b.name || '')) continue;\n      if (!['success', 'finished', 'completed', 'sending', 'running'].includes(String(b.status || '').toLowerCase())) continue;\n      lote.push({\n        id_externo: String(b.id),\n        campanha: b.name,\n        enviado_em: quando,\n        canal: 'whatsapp_api',\n        tipo: 'marketing',\n        copy_texto: `Template ${b.templateId || 'não informado'} (Unnichat)`,\n        publico_lista: conta,\n        tamanho_lista: Number(b.contactsAmount || 0),\n      });\n    }\n  }\n}\nreturn [{ json: { total: lote.length, lote: lote.slice(0, 1000) } }];"
   }
  },
