  {
   "id": "s11",
   "name": "Montar lote",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2000,
    -120
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "// Tamanho da lista = participantes atuais dos grupos da campanha (entradas − saídas do analytics).\n// A SendAPI não expõe o texto nem quantos grupos receberam: canal 'grupo', sem retorno (dispensado para grupo).\nconst campanhas = $('Envios desde 01/10').all();\nconst analises = $input.all();\nconst lote = [];\ncampanhas.forEach((c, i) => {\n  const an = (analises[i] && analises[i].json) || {};\n  const part = Math.max(Number(an?.add?.total || 0) - Number(an?.remove?.total || 0), 0);\n  for (const e of c.json.envios) {\n    lote.push({\n      id_externo: String(e.id),\n      campanha: c.json.nome,\n      enviado_em: e.quando,\n      canal: 'grupo',\n      copy_texto: 'Mensagem enviada aos grupos pelo SendFlow (a API não expõe o texto).',\n      publico_lista: `Grupos da campanha ${c.json.nome}`.slice(0, 200),\n      tamanho_lista: part > 0 ? part : null,\n    });\n  }\n});\nreturn [{ json: { total: lote.length, lote: lote.slice(0, 1000) } }];"
   }
  },
