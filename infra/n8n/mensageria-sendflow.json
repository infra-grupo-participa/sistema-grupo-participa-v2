  {
   "id": "s7",
   "name": "Envios desde 01/10",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "// Um disparo = uma ação raiz sendMessages com sucesso, desde 01/10/2026 (decisão do João).\n// Sai um item por campanha (release) com envios; nenhum envio = item {vazio:true} (o log registra execução ok).\nconst INICIO = '2026-10-01';\nconst nomes = {};\nfor (const it of $('Campanhas').all()) { const r = it.json; if (r && r.id) nomes[r.id] = r.name || (r.group && r.group.name) || r.id; }\nconst porRelease = {}, visto = new Set();\nfor (const it of $input.all()) {\n  for (const a of (it.json.actions || [])) {\n    if (!a || visto.has(a.id) || a.type !== 'sendMessages' || a.success !== true) continue; visto.add(a.id);\n    const quando = a.startedAt || a.scheduledTo || a.createdAt; if (!quando || quando < INICIO) continue;\n    const rel = a.releaseId || 'sem-campanha';\n    (porRelease[rel] = porRelease[rel] || []).push({ id: a.id, quando });\n  }\n}\nconst out = Object.entries(porRelease).map(([releaseId, envios]) => ({ json: { releaseId, nome: nomes[releaseId] || releaseId, envios } }));\nreturn out.length ? out : [{ json: { vazio: true } }];"
   }
  },
  {
   "id": "s8",
   "name": "Teve envio?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    1400,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.vazio === true }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "notEquals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
