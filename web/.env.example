# ── Supabase ──────────────────────────────────────────────────────────────
# Produção:    https://mbvybujpkwuorhtdzcde.supabase.co
# Homologação: https://msjppzivlxmqclhxqutd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NUNCA expor ao browser. Usado em Route Handlers (fluxos públicos de
# placa, gestão de usuários, e-mail, admin-dev).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de e-mail, redirect de convite).
NEXT_PUBLIC_APP_URL=https://grupoparticipa.app.br
# Domínios oficiais aceitos em endpoints públicos (origin/referer check).
APP_ALLOWED_ORIGINS=https://grupoparticipa.app.br,https://homologacao.grupoparticipa.app.br
APP_ENV=production

# ── E-mail (status / entrevista) ───────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=Time Holding Brasil <contato@grupoparticipa.app.br>
ADMIN_EMAIL=contato@grupoparticipa.app.br

# ── Zoom (sala da entrevista — Server-to-Server OAuth) ─────────────────────
# Sem credenciais → o agendamento é salvo sem link (fallback gracioso).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── IA Depoimentos (highlights via Groq) ───────────────────────────────────
GROQ_API_KEY=
GROQ_HIGHLIGHTS_MODEL=llama-3.3-70b-versatile

# ── Base de Alunos (flags de tela — lidas no build; mudar pede rebuild) ────
# Ligadas por padrão. "off" desliga sem apagar nada:
#   NEXT_PUBLIC_ALUNO_CONCILIACAO=off → some a aba Conciliação, o contador e os itens na ficha.
#   NEXT_PUBLIC_ALUNO_PROGRAMA=off    → some a coluna Programa, os filtros Programa/Comprovação e as evidências.
NEXT_PUBLIC_ALUNO_CONCILIACAO=
NEXT_PUBLIC_ALUNO_PROGRAMA=

# ── CRM Comercial (lida no build; mudar pede rebuild) ──────────────────────
# supabase (padrão) = banco real (RPCs crm_*); mock = dados de demonstração em memória.
# NEXT_PUBLIC_COMERCIAL_FONTE=mock
# Departamento Comercial liberado para gestor/vendedor do Comercial (área comercial + função comercial.vender),
# além de admin/dev. Padrão ligado; false volta a só admin/dev.
# NEXT_PUBLIC_COMERCIAL_VENDEDORES=false

# Acesso por departamento/área. Desligada por padrão; só ligar após validar a fase 1 do banco.
# NEXT_PUBLIC_ACESSO_V2=true

# ── MCP do Comercial (/api/mcp — docs/projetos/comercial/mcp.md) ────────────
# Não precisa de variável própria: usa a SUPABASE_SERVICE_ROLE_KEY só para public.crm_mcp_autenticar e
# public.crm_mcp_rpc (que rebaixa para authenticated com as claims do dono do token). O antigo SUPABASE_JWT_SECRET
# deixou de ser usado em 08/10/2026 (migration 20261008150823) — se estiver na Hostinger, pode remover.

# ── Marketing > Web (só desenvolvimento) ───────────────────────────────────
# Modo de demonstração das telas /marketing/web: números INVENTADOS, sem banco.
# Só liga com `npm run dev` (em produção, NODE_ENV=production, nunca liga). Não definir no servidor.
# NEXT_PUBLIC_WEB_DEMO=1

# ── Captura de lead (POST /api/captura/lead — docs/captura-de-lead.md) ──────
# Server-only — NUNCA expor. Bearer que o servidor da página (submit.php) manda. Mínimo 32 caracteres
# (gerar com `openssl rand -hex 32`). Vazio = a rota responde 503 e não grava nada.
CAPTURA_LEAD_SECRET=
